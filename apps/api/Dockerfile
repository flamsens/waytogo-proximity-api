# Generated by Nx (`nx g @nx/node:setup-docker`), adapted:
# - build inside the image (multi-stage), so `docker compose up --build` needs nothing on the host;
# - build context is the repo root (the generated `COPY ../../dist` escaped the context);
# - Node 24, non-root user, /data volume and a healthcheck.
# Build with `npx nx docker:build api` or `docker compose build`.

# ---- Build stage: install all deps, build the app, prune its package.json/lockfile ----
FROM docker.io/node:24-alpine AS build
ENV NX_DAEMON=false NX_NO_CLOUD=true
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npx nx build api --configuration=production && npx nx run api:prune

# ---- Runtime stage: only the built app and its production dependencies ----
FROM docker.io/node:24-alpine
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
WORKDIR /app
COPY --from=build /app/dist/apps/api .
RUN npm ci --omit=dev && npm cache clean --force \
  && mkdir -p /data && chown node:node /data
USER node
VOLUME /data
EXPOSE 3000
# /health answers 503 only when no data is loaded; stale operators never fail the check.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
  CMD wget -qO- http://127.0.0.1:3000/health > /dev/null || exit 1
CMD [ "node", "main.js" ]
